# Copy of this file lives at server/config.env (never commit that one).
# Your Anthropic API key, from console.anthropic.com. Set a monthly spend limit there too.
ANTHROPIC_API_KEY=

# Port the app is served on: http://<this-computer>.local:8000
PORT=8000

# Model used to mark sentences.
CLOZE_MODEL=claude-opus-5-5
